<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base dark fantasy theme -->
    <style name="Theme.BecomingALegend" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/gold_accent</item>
        <item name="colorPrimaryDark">@color/gold_dark</item>
        <item name="colorAccent">@color/gold_accent</item>
        <item name="colorOnPrimary">@color/background_dark</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Immersive theme for Game and Combat screens -->
    <style name="Theme.BecomingALegend.Immersive">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.BecomingALegend.Button.Gold" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/gold_accent</item>
        <item name="android:textColor">@color/background_dark</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="android:paddingTop">@dimen/spacing_medium</item>
        <item name="android:paddingBottom">@dimen/spacing_medium</item>
    </style>

    <style name="Widget.BecomingALegend.Button.Dark" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/card_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.BecomingALegend.Button.Combat" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_combat</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.BecomingALegend.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">@dimen/corner_radius_large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- World Selection Card (highlighted) -->
    <style name="Widget.BecomingALegend.Card.World" parent="Widget.BecomingALegend.Card">
        <item name="cardBackgroundColor">@color/card_background_light</item>
    </style>
</resources>
